# .env.local — For running Django natively on your Mac
# Infrastructure (Postgres, Redis, ES, RabbitMQ) run in Docker,
# but Django/Celery run directly on your machine.

# Django
SECRET_KEY=dev-secret-key-replace-in-production
DEBUG=True
ALLOWED_HOSTS=*

# PostgreSQL (localhost, not the Docker service name)
POSTGRES_DB=searchdb
POSTGRES_USER=search
POSTGRES_PASSWORD=search
DATABASE_URL=postgres://search:search@localhost:5432/searchdb

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# Redis
REDIS_URL=redis://localhost:6379/0

# RabbitMQ / Celery
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Rate Limiting
DEFAULT_RATE_LIMIT=100
